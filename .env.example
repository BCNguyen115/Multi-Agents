# ============================================
# Multi-Agent Enterprise MVP — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your actual values.

# --- OpenRouter LLM API ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=gpt-4o-mini

# --- Model Tiering (override for latency optimization) ---
FAST_LLM_MODEL=openai/gpt-4o-mini
HEAVY_LLM_MODEL=anthropic/claude-3.5-sonnet
MEM0_LLM_MODEL=openai/gpt-4o-mini

# --- PostgreSQL + Pgvector ---
POSTGRES_URL=postgresql://user:password@localhost:5432/multi_agent_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Application ---
LOG_LEVEL=INFO

# --- TEI Reranker Service ---
RERANKER_ENDPOINT=http://tei-reranker:80/rerank
RERANK_TOP_K=5
HYBRID_CANDIDATES_K=20      # fused vector+keyword candidates kept
RERANK_POOL_K=10            # candidates the cross-encoder scores (cost = pool x text length)
MAX_RERANK_TEXT_LENGTH=1000 # chars per candidate; eval on CPU TEI: 500 = MRR .53 / 2.4s, 1000 = MRR .58 / 4.2s
RERANKER_TIMEOUT=8.0        # TOTAL seconds for one rerank; on timeout the fused order is used (do not set 30)

# --- RAG retrieval / answering (defaults are fine; tune with `python -m scripts.run_rag_eval`) ---
# RAG_QUERY_MODE=both          # raw | hyde | both
# RAG_MIN_VECTOR_SCORE=0.30   # best cosine similarity below this = "no relevant document found"
# RAG_HISTORY_MESSAGES=4       # chat messages used to rewrite follow-up questions

# --- HuggingFace Hub ---
HF_TOKEN=

# --- Security ---
INTERNAL_JWT_SECRET=your-enterprise-secret-key-change-me
# Gateway authentication. off = anonymous single user (local dev only). jwt = every /api call needs a Bearer token
# (the browser has no login screen: put an identity-aware proxy in front, or mint tokens with `python -m scripts.make_token`).
# jwt mode refuses to start with a missing/short/placeholder secret or the placeholder INTERNAL_JWT_SECRET above.
# off = anonymous, local development only. jwt (anything exposed) refuses to start without SANDBOX_URL + SANDBOX_SECRET.
AUTH_MODE=off
# AUTH_JWT_SECRET=                 # HS256 secret, >= 32 random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
# AUTH_JWKS_URL=                   # or your identity provider's JWKS endpoint (RS256/ES256); wins over the secret
# AUTH_JWT_AUDIENCE=  AUTH_JWT_ISSUER=      # verified only when set
# AUTH_TENANT_CLAIM=tenant_id  AUTH_DEPARTMENT_CLAIM=department_id  AUTH_ROLES_CLAIM=roles
# HITL_APPROVER_ROLES=["approver","admin"]  # roles allowed to approve sensitive actions
# Analysis sandbox container (docker compose requires it): shared HMAC secret, at least 16 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SANDBOX_SECRET=
# Without docker (local uvicorn) leave SANDBOX_URL empty and the analysis code runs in a child process of the API.
# SANDBOX_URL=http://python-sandbox:8080

# Built-in login screen (AUTH_MODE=jwt + AUTH_JWT_SECRET): who may sign in. One JSON list; make each entry with
#   python -m scripts.make_user --username alice --roles admin --tenant acme --department legal
# AUTH_USERS=[{"username":"alice","password_hash":"scrypt$...","roles":["admin"],"tenant_id":"acme","department_id":"legal"}]
# Self-service sign-up from the login dialog (POST /api/auth/register). OFF by default: an internal system normally gets its
# accounts from an administrator. New accounts get NO roles and the default tenant/department (RLS_TENANT_ID/RLS_DEPARTMENT_ID).
# AUTH_ALLOW_REGISTRATION=true
# AUTH_TOKEN_TTL_MINUTES=480
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# KNOWLEDGE_UPLOAD_ROLES=["admin"]         # roles allowed to add/replace documents in the knowledge base from the chat (jwt mode)
# KNOWLEDGE_MAX_FILE_MB=25
# OCR for scanned PDFs added to the knowledge base (needs the tesseract binary; the backend image has it)
# OCR_ENABLED=true
# OCR_LANGS=vie+eng
# OCR_MAX_PAGES=80
# OCR_DPI=200
# KB_LLM_CONTEXT=false   # one LLM call per chunk of an uploaded document: a context sentence stored as [Context: ...]; see docs/RAG_REVIEW_AND_FIXES.md
# Database Agent runs LLM-written SQL: give it a read-only PostgreSQL role (SELECT on DB_AGENT_TABLES only, 15 s statement timeout).
# Leave empty and it uses the application's own account (a warning is logged). python -c "import secrets;print(secrets.token_urlsafe(24))"
DB_AGENT_PASSWORD=
# DB_AGENT_ROLE=agent_readonly  DB_AGENT_TABLES=["knowledge_documents"]
# Browser origins allowed by the gateway (JSON list)
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ============================================
# Docker Compose (docker compose up) — REQUIRED values have no default
# ============================================
# URL-encode special characters: the password is embedded in connection URLs.
# On an EXISTING postgres_data volume it must match the password the DB was created with.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=agentdb
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
# Tracing (Langfuse at http://localhost:3005). Compose creates the Langfuse project, the API keys below and the admin
# login on first start, so set all of them BEFORE `docker compose up`; then LANGFUSE_ENABLED=true. The backend checks
# the keys against the server at start (log line "Langfuse tracing ENABLED ...") and keeps running with tracing off if not.
#   keys:     LANGFUSE_PUBLIC_KEY=pk-lf-$(openssl rand -hex 16)   LANGFUSE_SECRET_KEY=sk-lf-$(openssl rand -hex 16)
#   login:    LANGFUSE_INIT_USER_EMAIL / LANGFUSE_INIT_USER_PASSWORD (min 8 chars)
# These are applied only while the Langfuse database is still empty; later changes are made in the Langfuse UI.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=
# Set false to build a ~400 MB smaller backend image (disables Crawl4AI web crawling)
INSTALL_BROWSER=true

